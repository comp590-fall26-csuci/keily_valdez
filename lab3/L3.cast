[0.007, "o", "#include <stdio.h>\r\n#include \"fibonacci.h\"\r\n\r\nint main(void) {\r\n    int term = 10;\r\n    printf(\"The %dth Fibonacci number is %d\\n\", term, fibonacci(term));\r\n    printf(\"The theoretical Golden Ratio is %f\\n\", golden_ratio_approx(term));\r\n    return 0;\r\n}\r\n"]
[0.001, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                                                                 \r \r"]
