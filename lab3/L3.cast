[0.008, "o", "\u001b[1G\u001b[0K\r\n\u001b[31m\u001b[1m30\u001b[22m\u001b[39m vulnerabilities (23 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m, 2 \u001b[31m\u001b[1mhigh\u001b[22m\u001b[39m, 5 \u001b[35m\u001b[1mcritical\u001b[22m\u001b[39m)\r\n\r\nTo address all issues possible (including breaking changes), run:\r\n  npm audit fix --force\r\n\r\nSome issues need review, and may require choosing\r\na different dependency.\r\n\r\nRun `npm audit` for details.\r\n⠋"]
[0.000, "o", "\u001b[1G\u001b[0K\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94minstall-scripts\u001b[39m 1 package has install scripts not yet covered by allowScripts:\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94minstall-scripts\u001b[39m   node-pty@1.2.0-beta.15 (install: node scripts/prebuild.js || node-gyp rebuild; postinstall: node scripts/post-install.js)\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94minstall-scripts\u001b[39m\r\n\u001b[1mnpm\u001b[22m \u001b[33mwarn\u001b[39m \u001b[94minstall-scripts\u001b[39m Run `npm install-scripts ls` to review, or `npm install-scripts approve <pkg>` to allow.\r\n⠋"]
