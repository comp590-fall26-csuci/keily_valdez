[0.000, "o", "\u001b[1;1H\u001b[J\u001b[7m  UW PICO 5.09                         File: lab1.py                            \u001b[27m\u001b[3;1Hdef iterative_fib(n):\u001b[4;9Ha,b = 0,1\u001b[5;9Hsequence = []\u001b[7;9Hfor _ in range(n):\u001b[8;17Hsequence.append(a)\u001b[9;17Ha,b = b, a+b\u001b[11;9Hreturn sequence\u001b[13;1Hif __name__ == \"__main__\":\u001b[14;9Hsequence = iterative_fib(25)\u001b[15;9Hwith open(\"output/fibonacci.txt\", \"w\") as f:\u001b[16;17Hfor num in sequence:\u001b[17;25Hf.write(str(num) + \"\\n\")\u001b[30;1H\u001b[K\u001b[31;1H\u001b[K\u001b[30;1H\u001b[7m^\u001b[27m\u001b[7mG\u001b[27m Get Help  \u001b[7m^\u001b[27m\u001b[7mO\u001b[27m WriteOut  \u001b[7m^\u001b[27m\u001b[7mR\u001b[27m Read File \u001b[7m^\u001b[27m\u001b[7mY\u001b[27m Prev Pg   \u001b[7m^\u001b[27m\u001b[7mK\u001b[27m Cut Text  \u001b[7m^\u001b[27m\u001b[7mC\u001b[27m Cur Pos   \u001b[K"]
[0.000, "o", "\u001b[31;1H\u001b[7m^\u001b[27m\u001b[7mX\u001b[27m Exit      \u001b[7m^\u001b[27m\u001b[7mJ\u001b[27m Justify   \u001b[7m^\u001b[27m\u001b[7mW\u001b[27m Where is  \u001b[7m^\u001b[27m\u001b[7mV\u001b[27m Next Pg   \u001b[7m^\u001b[27m\u001b[7mU\u001b[27m UnCut Text\u001b[7m^\u001b[27m\u001b[7mT\u001b[27m To Spell  \u001b[K\u001b[3;1H"]
